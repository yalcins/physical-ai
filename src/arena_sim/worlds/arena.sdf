<?xml version="1.0"?>
<!-- 2 x 2 m Physical AI arenasi. Duvarlar 18 mm MDF, 12 cm yukseklik. -->
<sdf version="1.9">
  <world name="arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Arena zemini (sadece gorsel) -->
    <model name="arena_floor">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2 2 0.002</size></box></geometry>
          <material><ambient>0.92 0.9 0.85 1</ambient><diffuse>0.92 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Duvarlar: ic olcu tam 2 x 2 m -->
    <model name="arena_walls">
      <static>true</static>
      <link name="link">
        <collision name="north_c"><pose>0 1.009 0.06 0 0 0</pose><geometry><box><size>2.036 0.018 0.12</size></box></geometry></collision>
        <visual name="north_v"><pose>0 1.009 0.06 0 0 0</pose><geometry><box><size>2.036 0.018 0.12</size></box></geometry>
          <material><ambient>0.7 0.55 0.35 1</ambient><diffuse>0.7 0.55 0.35 1</diffuse></material></visual>

        <collision name="south_c"><pose>0 -1.009 0.06 0 0 0</pose><geometry><box><size>2.036 0.018 0.12</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -1.009 0.06 0 0 0</pose><geometry><box><size>2.036 0.018 0.12</size></box></geometry>
          <material><ambient>0.7 0.55 0.35 1</ambient><diffuse>0.7 0.55 0.35 1</diffuse></material></visual>

        <collision name="east_c"><pose>1.009 0 0.06 0 0 0</pose><geometry><box><size>0.018 2.0 0.12</size></box></geometry></collision>
        <visual name="east_v"><pose>1.009 0 0.06 0 0 0</pose><geometry><box><size>0.018 2.0 0.12</size></box></geometry>
          <material><ambient>0.7 0.55 0.35 1</ambient><diffuse>0.7 0.55 0.35 1</diffuse></material></visual>

        <collision name="west_c"><pose>-1.009 0 0.06 0 0 0</pose><geometry><box><size>0.018 2.0 0.12</size></box></geometry></collision>
        <visual name="west_v"><pose>-1.009 0 0.06 0 0 0</pose><geometry><box><size>0.018 2.0 0.12</size></box></geometry>
          <material><ambient>0.7 0.55 0.35 1</ambient><diffuse>0.7 0.55 0.35 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Sabit engeller (senaryoya gore degistirilecek) -->
    <model name="obstacle_box">
      <static>true</static>
      <pose>0.45 0.35 0.06 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 0.15 0.12</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 0.15 0.12</size></box></geometry>
          <material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_cylinder">
      <static>true</static>
      <pose>-0.35 0.5 0.06 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.06</radius><length>0.12</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.06</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.85 0.3 0.25 1</ambient><diffuse>0.85 0.3 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Hareketli engeller ("sahadaki Pico robotlar"). Hareketi moving_obstacles_node verir;
         yaricap ve baslangic konumu pai_gym/world.py default_obstacles() ile ayni olmali. -->
    <model name="moving_1">
      <static>true</static>
      <pose>0.3 -0.4 0.06 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.12</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.82 0.31 0.24 1</ambient><diffuse>0.82 0.31 0.24 1</diffuse></material></visual>
      </link>
    </model>

    <model name="moving_2">
      <static>true</static>
      <pose>-0.5 0 0.06 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.12</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.82 0.31 0.24 1</ambient><diffuse>0.82 0.31 0.24 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
