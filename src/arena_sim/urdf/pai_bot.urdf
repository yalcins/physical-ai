<?xml version="1.0"?>
<!--
  pai_bot: Pi 4 ve Pico robotlarin ORTAK sasisi.
  Gercek robotu bu olculere gore yap:
    - Tekerlek capi 43 mm (yaricap 0.0215 m), genislik 19 mm
    - Tekerlek merkezleri arasi 115 mm
    - Sarhos teker: tekerlek aksinin 65 mm arkasinda
    - ToF sensorler: yerden ~5 cm yukseklikte, sol/sag +-30 derece
-->
<robot name="pai_bot">

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0215" rpy="0 0 0"/>
  </joint>

  <!-- Sasi + elektronik kati (tek kutu olarak) -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.02 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.13 0.09 0.04"/></geometry>
      <material name="plate"><color rgba="0.85 0.6 0.3 1"/></material>
    </visual>
    <collision>
      <origin xyz="-0.02 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.13 0.09 0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.02 0 0.02" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.000283" ixy="0" ixz="0" iyy="0.00054" iyz="0" izz="0.000729"/>
    </inertial>
  </link>

  <!-- Tekerlekler -->
  <link name="left_wheel">
    <visual>
      <geometry><cylinder radius="0.0215" length="0.019"/></geometry>
      <material name="rubber"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.0215" length="0.019"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="2.91e-6" ixy="0" ixz="0" iyy="2.91e-6" iyz="0" izz="4.62e-6"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.0575 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry><cylinder radius="0.0215" length="0.019"/></geometry>
      <material name="rubber"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.0215" length="0.019"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="2.91e-6" ixy="0" ixz="0" iyy="2.91e-6" iyz="0" izz="4.62e-6"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.0575 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Sarhos teker (surtunmesiz kure) -->
  <link name="caster">
    <visual>
      <geometry><sphere radius="0.0107"/></geometry>
      <material name="metal"><color rgba="0.7 0.7 0.7 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.0107"/></geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="4.58e-7" ixy="0" ixz="0" iyy="4.58e-7" iyz="0" izz="4.58e-7"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="-0.065 0 -0.0108" rpy="0 0 0"/>
  </joint>

  <!-- ToF sensorleri (TOF400C VL53L1X: 27 derece, 4 m) -->
  <link name="tof_left_link">
    <visual>
      <geometry><box size="0.005 0.02 0.012"/></geometry>
      <material name="sensor"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <inertial><mass value="0.001"/><inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/></inertial>
  </link>
  <joint name="tof_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tof_left_link"/>
    <origin xyz="0.04 0.03 0.03" rpy="0 0 0.5236"/>
  </joint>

  <link name="tof_center_link">
    <visual>
      <geometry><box size="0.005 0.02 0.012"/></geometry>
      <material name="sensor"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <inertial><mass value="0.001"/><inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/></inertial>
  </link>
  <joint name="tof_center_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tof_center_link"/>
    <origin xyz="0.047 0 0.03" rpy="0 0 0"/>
  </joint>

  <link name="tof_right_link">
    <visual>
      <geometry><box size="0.005 0.02 0.012"/></geometry>
      <material name="sensor"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <inertial><mass value="0.001"/><inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/></inertial>
  </link>
  <joint name="tof_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tof_right_link"/>
    <origin xyz="0.04 -0.03 0.03" rpy="0 0 -0.5236"/>
  </joint>

  <!-- IMU (MPU6050) -->
  <link name="imu_link">
    <inertial><mass value="0.001"/><inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.02 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Gazebo ayarlari ===================== -->

  <gazebo reference="caster_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="tof_left_link">
    <sensor name="tof_left" type="gpu_lidar">
      <topic>/tof_left/scan</topic>
      <gz_frame_id>tof_left_link</gz_frame_id>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal><samples>9</samples><resolution>1</resolution><min_angle>-0.2356</min_angle><max_angle>0.2356</max_angle></horizontal>
          <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
        </scan>
        <range><min>0.04</min><max>4.0</max><resolution>0.001</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="tof_center_link">
    <sensor name="tof_center" type="gpu_lidar">
      <topic>/tof_center/scan</topic>
      <gz_frame_id>tof_center_link</gz_frame_id>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal><samples>9</samples><resolution>1</resolution><min_angle>-0.2356</min_angle><max_angle>0.2356</max_angle></horizontal>
          <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
        </scan>
        <range><min>0.04</min><max>4.0</max><resolution>0.001</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="tof_right_link">
    <sensor name="tof_right" type="gpu_lidar">
      <topic>/tof_right/scan</topic>
      <gz_frame_id>tof_right_link</gz_frame_id>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal><samples>9</samples><resolution>1</resolution><min_angle>-0.2356</min_angle><max_angle>0.2356</max_angle></horizontal>
          <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
        </scan>
        <range><min>0.04</min><max>4.0</max><resolution>0.001</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.115</wheel_separation>
      <wheel_radius>0.0215</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
