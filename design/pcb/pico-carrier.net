(export (version "E")
  (design (source "pico-carrier") (date "2026-10-07") (tool "pcb_design.py"))
  (components
    (comp (ref "U1") (value "Raspberry Pi Pico 2 W") (footprint "pico-carrier:RaspberryPi_Pico_THT") (description "MCU modulu (2 x 20 soket)") (sheetpath (names "/") (tstamps "/")) (tstamp "00000001"))
    (comp (ref "J1") (value "Surucu baglantisi (TB6612)") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x10_P2.54mm_Vertical") (description "TB6612 modulune 10 telli kablo") (sheetpath (names "/") (tstamps "/")) (tstamp "00000002"))
    (comp (ref "J3") (value "TOF400C sol") (footprint "Connector_PinSocket_2.54mm:PinSocket_1x05_P2.54mm_Vertical") (description "ToF modulu (kart sirasi: GND VIN SDA SCL XSHUT; modul kablosu pin sirasini duzeltir)") (sheetpath (names "/") (tstamps "/")) (tstamp "00000003"))
    (comp (ref "J4") (value "TOF400C orta") (footprint "Connector_PinSocket_2.54mm:PinSocket_1x05_P2.54mm_Vertical") (description "ToF modulu") (sheetpath (names "/") (tstamps "/")) (tstamp "00000004"))
    (comp (ref "J5") (value "TOF400C sag") (footprint "Connector_PinSocket_2.54mm:PinSocket_1x05_P2.54mm_Vertical") (description "ToF modulu") (sheetpath (names "/") (tstamps "/")) (tstamp "00000005"))
    (comp (ref "J7") (value "Sol enkoder") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical") (description "Sol motor enkoderi (sira motora gore DOGRULANACAK)") (sheetpath (names "/") (tstamps "/")) (tstamp "00000006"))
    (comp (ref "J8") (value "Sag enkoder") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical") (description "Sag motor enkoderi") (sheetpath (names "/") (tstamps "/")) (tstamp "00000007"))
    (comp (ref "J9") (value "LiPo girisi (1S)") (footprint "Connector_JST:JST_PH_B2B-PH-K_1x02_P2.00mm_Vertical") (description "JST-PH 2 pin: pil + / - (KUTUP YONUNU pile gore DOGRULA)") (sheetpath (names "/") (tstamps "/")) (tstamp "00000008"))
    (comp (ref "D1") (value "1N5819") (footprint "Diode_THT:D_DO-41_SOD81_P2.54mm_Vertical_KathodeUp") (description "Pil -> VSYS (USB ile besleme geri akisini engeller)") (sheetpath (names "/") (tstamps "/")) (tstamp "00000009"))
    (comp (ref "R1") (value "100 k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P2.54mm_Vertical") (description "Pil bolucu ust") (sheetpath (names "/") (tstamps "/")) (tstamp "0000000a"))
    (comp (ref "R2") (value "100 k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P2.54mm_Vertical") (description "Pil bolucu alt") (sheetpath (names "/") (tstamps "/")) (tstamp "0000000b"))
    (comp (ref "C1") (value "100 nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm") (description "ADC filtresi (R2 uzerinde)") (sheetpath (names "/") (tstamps "/")) (tstamp "0000000c"))
    (comp (ref "C2") (value "100 uF / 10 V") (footprint "Capacitor_THT:CP_Radial_D6.3mm_P2.50mm") (description "Motor gucu (VM) depolama") (sheetpath (names "/") (tstamps "/")) (tstamp "0000000d"))
    (comp (ref "C4") (value "100 nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm") (description "Sensor besleme hatti") (sheetpath (names "/") (tstamps "/")) (tstamp "0000000e"))
    (comp (ref "W2") (value "Tel kopru 3V3") (footprint "pico-carrier:WireLink_P30.48mm") (description "+3V3 ve +3V3_L adalarini Pico'nun ustunden (yalitimli tel) birlestirir") (sheetpath (names "/") (tstamps "/")) (tstamp "0000000f"))
  )
  (nets
    (net (code "1") (name "GND")
      (node (ref "U1") (pin "38") (pinfunction "GND_38"))
      (node (ref "J1") (pin "8") (pinfunction "GND"))
      (node (ref "J9") (pin "2") (pinfunction "-"))
      (node (ref "R2") (pin "2") (pinfunction "2"))
      (node (ref "C1") (pin "2") (pinfunction "2"))
      (node (ref "C2") (pin "2") (pinfunction "-"))
    )
    (net (code "2") (name "GND_L")
      (node (ref "U1") (pin "3") (pinfunction "GND_3"))
      (node (ref "J3") (pin "1") (pinfunction "GND"))
      (node (ref "J4") (pin "1") (pinfunction "GND"))
      (node (ref "J5") (pin "1") (pinfunction "GND"))
      (node (ref "J7") (pin "1") (pinfunction "ENC_GND"))
      (node (ref "J8") (pin "1") (pinfunction "ENC_GND"))
      (node (ref "C4") (pin "2") (pinfunction "2"))
    )
    (net (code "3") (name "+3V3")
      (node (ref "U1") (pin "36") (pinfunction "3V3_OUT"))
      (node (ref "W2") (pin "1") (pinfunction "1"))
    )
    (net (code "4") (name "+3V3_L")
      (node (ref "W2") (pin "2") (pinfunction "2"))
      (node (ref "J3") (pin "2") (pinfunction "VIN"))
      (node (ref "J4") (pin "2") (pinfunction "VIN"))
      (node (ref "J5") (pin "2") (pinfunction "VIN"))
      (node (ref "J7") (pin "2") (pinfunction "ENC_VCC"))
      (node (ref "J8") (pin "2") (pinfunction "ENC_VCC"))
      (node (ref "C4") (pin "1") (pinfunction "1"))
    )
    (net (code "5") (name "VSYS")
      (node (ref "D1") (pin "1") (pinfunction "K"))
      (node (ref "U1") (pin "39") (pinfunction "VSYS"))
    )
    (net (code "6") (name "VBAT_SW")
      (node (ref "J9") (pin "1") (pinfunction "+"))
      (node (ref "J1") (pin "10") (pinfunction "VM"))
      (node (ref "J1") (pin "9") (pinfunction "VCC"))
      (node (ref "D1") (pin "2") (pinfunction "A"))
      (node (ref "R1") (pin "1") (pinfunction "1"))
      (node (ref "C2") (pin "1") (pinfunction "+"))
    )
    (net (code "7") (name "I2C_SDA")
      (node (ref "U1") (pin "6") (pinfunction "GP4"))
      (node (ref "J3") (pin "3") (pinfunction "SDA"))
      (node (ref "J4") (pin "3") (pinfunction "SDA"))
      (node (ref "J5") (pin "3") (pinfunction "SDA"))
    )
    (net (code "8") (name "I2C_SCL")
      (node (ref "U1") (pin "7") (pinfunction "GP5"))
      (node (ref "J3") (pin "4") (pinfunction "SCL"))
      (node (ref "J4") (pin "4") (pinfunction "SCL"))
      (node (ref "J5") (pin "4") (pinfunction "SCL"))
    )
    (net (code "9") (name "XSHUT_L")
      (node (ref "U1") (pin "9") (pinfunction "GP6"))
      (node (ref "J3") (pin "5") (pinfunction "XSHUT"))
    )
    (net (code "10") (name "XSHUT_C")
      (node (ref "U1") (pin "10") (pinfunction "GP7"))
      (node (ref "J4") (pin "5") (pinfunction "XSHUT"))
    )
    (net (code "11") (name "XSHUT_R")
      (node (ref "U1") (pin "11") (pinfunction "GP8"))
      (node (ref "J5") (pin "5") (pinfunction "XSHUT"))
    )
    (net (code "12") (name "ENC_L_A")
      (node (ref "U1") (pin "14") (pinfunction "GP10"))
      (node (ref "J7") (pin "3") (pinfunction "ENC_A"))
    )
    (net (code "13") (name "ENC_L_B")
      (node (ref "U1") (pin "15") (pinfunction "GP11"))
      (node (ref "J7") (pin "4") (pinfunction "ENC_B"))
    )
    (net (code "14") (name "ENC_R_A")
      (node (ref "U1") (pin "16") (pinfunction "GP12"))
      (node (ref "J8") (pin "3") (pinfunction "ENC_A"))
    )
    (net (code "15") (name "ENC_R_B")
      (node (ref "U1") (pin "17") (pinfunction "GP13"))
      (node (ref "J8") (pin "4") (pinfunction "ENC_B"))
    )
    (net (code "16") (name "PWMA")
      (node (ref "U1") (pin "21") (pinfunction "GP16"))
      (node (ref "J1") (pin "1") (pinfunction "PWMA"))
    )
    (net (code "17") (name "AIN1")
      (node (ref "U1") (pin "22") (pinfunction "GP17"))
      (node (ref "J1") (pin "2") (pinfunction "AIN1"))
    )
    (net (code "18") (name "AIN2")
      (node (ref "U1") (pin "24") (pinfunction "GP18"))
      (node (ref "J1") (pin "3") (pinfunction "AIN2"))
    )
    (net (code "19") (name "BIN1")
      (node (ref "U1") (pin "25") (pinfunction "GP19"))
      (node (ref "J1") (pin "4") (pinfunction "BIN1"))
    )
    (net (code "20") (name "BIN2")
      (node (ref "U1") (pin "26") (pinfunction "GP20"))
      (node (ref "J1") (pin "5") (pinfunction "BIN2"))
    )
    (net (code "21") (name "PWMB")
      (node (ref "U1") (pin "27") (pinfunction "GP21"))
      (node (ref "J1") (pin "6") (pinfunction "PWMB"))
    )
    (net (code "22") (name "STBY")
      (node (ref "U1") (pin "29") (pinfunction "GP22"))
      (node (ref "J1") (pin "7") (pinfunction "STBY"))
    )
    (net (code "23") (name "VBAT_SENSE")
      (node (ref "U1") (pin "31") (pinfunction "GP26"))
      (node (ref "R1") (pin "2") (pinfunction "2"))
      (node (ref "R2") (pin "1") (pinfunction "1"))
      (node (ref "C1") (pin "1") (pinfunction "1"))
    )
  )
)
