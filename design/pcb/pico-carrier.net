    (comp (ref "D1") (value "1N5819") (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal") (description "Regulator cikisi -> VSYS (geri akis korumasi)") (sheetpath (names "/") (tstamps "/")) (tstamp "0000000d"))
